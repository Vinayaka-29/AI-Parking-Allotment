# AI-Park Environment Configuration
# Copy this file to .env and modify as needed

# Application Settings
APP_NAME=AI-PARK
APP_VERSION=0.1.0

# Camera Configuration Options:
# WEBCAM - Use local webcam (default)
# FILE - Use a local video file (provide path in CAMERA_URL)
# URL - Use a network stream URL (provide URL in CAMERA_URL)
# SAMPLE - Use simulated/demo mode (no URL needed)

CAMERA_SOURCE=WEBCAM
CAMERA_URL=  # For FILE: path/to/video.mp4  |  For URL: rtsp://... or http://.../stream.m3u8
CAMERA_FPS=10
CAMERA_ENABLED=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173